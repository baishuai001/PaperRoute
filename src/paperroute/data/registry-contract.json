      "nonempty_fields": [
        "direction_id",
        "axis",
        "action",
        "anchor_value",
        "proposed_value",
        "scientific_rationale",
        "contribution_role",
        "required_evidence",
        "donor_plan",
        "risk"
      ],
      "enums": {
        "axis": [
          "disease_context",
          "biological_object",
          "central_relation",
          "primary_outcome",
          "evidence_architecture",
          "data",
          "method",
          "code",
          "claim_level"
        ],
        "action": ["retain", "repair", "replace", "extend", "drop"],
        "contribution_role": [
          "none",
          "validity_repair",
          "feasibility_repair",
          "novelty",
          "scientific_value",
          "scope_control",
          "learning"
        ]
      },
      "references": [
        {
          "field": "direction_id",
          "target": "directions",
          "optional": false
        },
        {
          "field": "linked_flaw_ids",
          "target": "anchor_flaws",
          "optional": true,
          "multi": true
        }
      ]
    },
