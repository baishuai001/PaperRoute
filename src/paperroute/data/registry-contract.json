{
  "schema_version": "0.2.0",
  "g0_core_axes": [
    "disease_context",
    "biological_object",
    "central_relation",
    "primary_outcome",
    "evidence_architecture"
  ],
  "g0_change_axes": [
    "disease_context",
    "biological_object",
    "central_relation",
    "primary_outcome",
    "evidence_architecture",
    "data",
    "method",
    "code",
    "claim_level"
  ],
  "anchor_roles": [
    "question",
    "design",
    "data",
    "method",
    "code",
    "evidence_chain",
    "narrative",
    "negative_example"
  ],
  "project_statuses": [
    "draft",
    "direction_review",
    "active",
    "paused",
    "blocked",
    "completed",
    "archived"
  ],
  "gates": [
    "G0_DIRECTION",
    "G1_EVIDENCE",
    "G2_DESIGN",
    "G3_IMPLEMENTATION",
    "G4_VERIFICATION",
    "G5_CLAIM_AUDIT",
    "G6_RELEASE"
  ],
  "registries": {
    "papers": {
      "file": "papers.tsv",
      "id_field": "paper_id",
      "required_columns": [
        "paper_id",
        "title",
        "doi",
        "role",
        "status",
        "source_uri",
        "notes"
      ],
      "enums": {
        "role": ["anchor", "supporting", "method", "data", "other"],
        "status": ["candidate", "accepted", "rejected", "unavailable"]
      },
      "references": []
    },
    "directions": {
      "file": "directions.tsv",
      "id_field": "direction_id",
      "required_columns": [
        "direction_id",
        "version",
        "parent_direction_id",
        "direction_kind",
        "status",
        "title",
        "plain_language_question",
        "biological_unit",
        "decisive_evidence",
        "falsifier",
        "anchor_roles_used",
        "learning_objective",
        "target_contribution",
        "claim_ceiling",
        "approved_review_id"
      ],
      "nonempty_fields": [
        "direction_kind",
        "title",
        "plain_language_question",
        "biological_unit",
        "decisive_evidence",
        "falsifier",
        "anchor_roles_used",
        "learning_objective",
        "target_contribution",
        "claim_ceiling"
      ],
      "enums": {
        "direction_kind": [
          "umbrella",
          "manuscript_candidate",
          "training_only"
        ],
        "status": [
          "proposed",
          "pre_audit",
          "approved",
          "active",
          "challenged",
          "superseded",
          "rejected"
        ]
      },
      "references": [
        {
          "field": "parent_direction_id",
          "target": "directions",
          "optional": true
        },
        {
          "field": "approved_review_id",
          "target": "reviews",
          "optional": true
        }
      ]
    },
    "anchor_flaws": {
      "file": "anchor_flaws.tsv",
      "id_field": "flaw_id",
      "required_columns": [
        "flaw_id",
        "component_axis",
        "flaw_type",
        "affected_scope",
        "severity",
        "description",
        "evidence",
        "required_response",
        "candidate_implication",
        "status"
      ],
      "nonempty_fields": [
        "component_axis",
        "flaw_type",
        "affected_scope",
        "severity",
        "description",
        "evidence",
        "required_response",
        "candidate_implication",
        "status"
      ],
      "enums": {
        "component_axis": [
          "disease_context",
          "biological_object",
          "central_relation",
          "primary_outcome",
          "evidence_architecture",
          "data",
          "method",
          "code",
          "claim_level"
        ],
        "flaw_type": [
          "scientific_validity",
          "reproducibility",
          "evidence_gap",
          "feasibility",
          "reporting",
          "limitation"
        ],
        "affected_scope": ["claim", "module", "resource", "route"],
        "severity": ["minor", "major", "fatal_if_unrepaired"],
        "required_response": [
          "repair",
          "downgrade_claim",
          "replace_resource",
          "drop_component",
          "reject_if_indispensable",
          "disclose"
        ],
        "status": [
          "open",
          "planned",
          "accepted_limitation",
          "resolved"
        ]
      },
      "references": []
    },
    "direction_changes": {
      "file": "direction_changes.tsv",
      "id_field": "change_id",
      "required_columns": [
        "change_id",
        "direction_id",
        "axis",
        "action",
        "anchor_value",
        "proposed_value",
        "scientific_rationale",
        "contribution_role",
        "required_evidence",
        "donor_plan",
        "risk",
        "linked_flaw_ids"
