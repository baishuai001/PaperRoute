        "direction_id",
        "scientific_validity",
        "scientific_validity_basis",
        "feasibility",
        "feasibility_basis",
        "novelty",
        "novelty_basis",
        "scientific_value",
        "scientific_value_basis",
        "implementation_burden",
        "learning_value",
        "anchor_reuse",
        "nearest_neighbor_evidence",
        "key_tradeoff",
        "fatal_blocker",
        "recommendation",
        "status"
      ],
      "nonempty_fields": [
        "direction_id",
        "scientific_validity",
        "scientific_validity_basis",
        "feasibility",
        "feasibility_basis",
        "novelty",
        "novelty_basis",
        "scientific_value",
        "scientific_value_basis",
        "implementation_burden",
        "learning_value",
        "anchor_reuse",
        "nearest_neighbor_evidence",
        "key_tradeoff",
        "fatal_blocker",
        "recommendation",
        "status"
